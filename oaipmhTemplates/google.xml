<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE doc [
  <!ENTITY Person SYSTEM "google_person.xml">
]>

<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:so="https://schema.org/">
    <so:Dataset xmlns="https://schema.org/">
        <so:sameAs val="/acdh:hasIdentifier"/>
        <so:description val="/acdh:hasDescription" lang="if empty"></so:description>
        <so:name val="/acdh:hasTitle" lang="if empty"></so:name>
        <placeholder if="any(acdh:hasLicense)" remove="remove">
            <so:license 
                val="/acdh:hasLicense/acdh:hasIdentifier" 
                match="^https://vocabs.acdh.oeaw.ac.at/"
            />
        </placeholder>
        <placeholder if="none(acdh:hasLicense)" remove="remove">
            <so:license 
                val="/acdh:hasLicenseSummary" 
                match="^.*CC ([-A-Z]+) ([0-9.]+).*$"
                replace="https://creativecommons.org/licenses/\1/\2/"
            />
            <so:license 
                val="/acdh:hasLicenseSummary" 
                match="^.*CC0 ([0-9.]+):.*$"
                replace="https://creativecommons.org/publicdomain/zero/\1/"
            />
            <so:license 
                val="/acdh:hasLicenseSummary" 
                match="^.*Public Domain Mark ([0-9.]+):.*$"
                replace="https://creativecommons.org/publicdomain/mark/\1/"
            />
            <so:license 
                val="/acdh:hasLicenseSummary" 
                match="^.*InC:.*$"
                replace="http://rightsstatements.org/vocab/InC/1.0/"
            />
        </placeholder>
        <placeholder if="any(rdf:type == acdh:TopCollection)" remove="remove">
            <placeholder foreach="/acdh:hasEditor" remove="remove">
                <so:creator>&Person;</so:creator>
            </placeholder>
        </placeholder>
        <placeholder if="none(rdf:type == acdh:TopCollection)" remove="remove">
            <placeholder foreach="/acdh:hasCreator" remove="remove">
                <so:creator>&Person;</so:creator>
            </placeholder>
            <placeholder foreach="/acdh:hasEditor" remove="remove">
                <so:editor>&Person;</so:editor>
            </placeholder>
        </placeholder>
        <placeholder foreach="/acdh:hasAuthor" remove="remove">
            <so:author>&Person;</so:author>
        </placeholder>
    </so:Dataset>
</rdf:RDF>
